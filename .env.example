# --- Database ---
# PostgreSQL for normal use. The test suite uses in-memory SQLite automatically.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/order_approval

# --- LLM provider ---
# One of: mock | openai | anthropic | google_genai | ollama
# "mock" runs the full agent graph deterministically with NO API key required.
LLM_PROVIDER=mock

# --- Human-in-the-loop ---
# true  : the graph interrupts at PENDING_APPROVAL and the approver's action
#         resumes that same run (the decision becomes step N+1 of the trail)
# false : the graph ends at PENDING_APPROVAL and the approval is applied
#         directly as its own single-step execution
ENABLE_HITL=true

# Model name for the chosen provider (ignored in mock mode), e.g.:
#   openai       -> gpt-4o-mini
#   anthropic    -> claude-sonnet-5
#   google_genai -> gemini-2.5-flash
#   ollama       -> llama3.1
LLM_MODEL=

# Provider credentials (only the one you use is needed; none for mock/ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
